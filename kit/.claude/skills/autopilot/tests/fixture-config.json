{
  "owner": {
    "name": "Tester"
  },
  "timezone": "UTC",
  "timezone_label": "",
  "workday": {
    "start": "09:00",
    "end": "18:00",
    "lunch": {
      "start": "12:30",
      "end": "13:30"
    },
    "interrupt_buffer_pct": 15
  },
  "max_parallel_background": 3,
  "touchpoints_min": {
    "plan_approval": 10,
    "result_review": 25,
    "login_check": 2
  },
  "windows": [
    {
      "id": "release-cutoff",
      "utc": "12:00",
      "kind": "deadline",
      "label": "Example: release prep must be done before this"
    }
  ],
  "repos": {
    "api": {
      "path": "~/nonexistent-autopilot-fixture/api",
      "github": "acme/api",
      "base": "main"
    },
    "web": {
      "path": "~/nonexistent-autopilot-fixture/web",
      "github": "acme/web",
      "base": "main"
    },
    "infra": {
      "path": "~/nonexistent-autopilot-fixture/infra",
      "github": "acme/infra",
      "base": "master"
    },
    "docs": {
      "path": "~/nonexistent-autopilot-fixture/docs",
      "github": "acme/docs",
      "base": "master",
      "read_only": true
    }
  },
  "github": {
    "me": "me-handle",
    "search_scope": "org:acme",
    "teams": []
  },
  "intake": {
    "github": true,
    "local": true,
    "tracker": null,
    "adapters": []
  },
  "logins": [],
  "pr_watch": {
    "enabled": true,
    "interval_s": 600,
    "feedback_interval_s": 3600,
    "feedback_auto_dispatch": true,
    "feedback_include_bots": false,
    "stale_idle_days": 30,
    "auto_dispatch": true
  },
  "notify": {
    "channel": "macos",
    "remind_after_min": 20,
    "window_risk_min": 30,
    "quiet_hours_allow": [
      "urgent"
    ]
  }
}